    <None Remove="Models\Filter\" />
    <None Remove="Models\response\" />
    <None Remove="Models\response\loan\" />
    <None Remove="Models\response\user\" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Controllers\Loan\" />
    <Folder Include="Models\request\Loan\" />
    <Folder Include="Models\Filter\" />
